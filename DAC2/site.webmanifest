{
  "name": "Detailed Auto Care",
  "short_name": "DAC",
  "description": "Mobile car detailing serving Kleinburg and surrounding areas",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "theme_color": "#0A0A0A",
  "background_color": "#0A0A0A",
  "orientation": "portrait-primary",
  "icons": [
    {
      "src": "/assets/img/favicon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    },
    {
      "src": "/assets/img/favicon.ico",
      "sizes": "32x32",
      "type": "image/x-icon"
    },
    {
      "src": "/assets/img/apple-touch-icon.png",
      "sizes": "180x180",
      "type": "image/png"
    }
  ],
  "screenshots": [
    {
      "src": "/assets/img/og.png",
      "sizes": "1200x630",
      "type": "image/png"
    }
  ]
}
